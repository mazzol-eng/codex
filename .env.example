# Local-only development defaults; never reuse them in production.
DATABASE_URL=postgresql://bothub:bothub_local@localhost:5432/bothub
REDIS_URL=redis://localhost:6379
BETTER_AUTH_URL=http://localhost:3000
# Generate a unique secret in production: openssl rand -base64 48
# Development generates and stores a local secret in ignored .data/ on first run.
AUTH_SECRET=
# Generate a 32-byte hex key for encrypting channel credentials.
ENCRYPTION_KEY=
# Fake delivery is the default, with no outbound requests.
EMAIL_MODE=fake
EMAIL_ENDPOINT=https://api.resend.com/emails
EMAIL_API_KEY=
EMAIL_FROM=BotHub <hello@example.com>
# Optional Google OAuth. Leave empty to hide the Google sign-in button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# TOTP is supported by the authentication backend; UI comes in the security phase.
NEXT_PUBLIC_ENABLE_BILLING=false
NEXT_PUBLIC_ENABLE_AI=false
# Channels and campaigns: memory runs locally with a durable PostgreSQL outbox between web/worker.
# Set redis to enable BullMQ and Redis pub/sub (Redis must be running).
QUEUE_MODE=memory
# HTTPS public base URL of this installation, without trailing slash.
# Required for existing Telegram, Meta verification and Twilio signed callback URLs.
# The value must match the public HTTPS URL used by providers, without a path.
PUBLIC_WEBHOOK_URL=
# Optional supported Meta Graph API version (defaults to v23.0).
META_GRAPH_VERSION=v23.0
# Tokens are entered in the connection screen and encrypted with ENCRYPTION_KEY.
# Development creates a private ignored .data/encryption-key when this key is empty.
