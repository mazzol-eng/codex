generator client {
  provider = "prisma-client"
  output = "../src/generated"
}
datasource db {
  provider = "postgresql"
}
model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  twoFactorEnabled Boolean @default(false)
  sessions Session[]
  accounts Account[]
  memberships Membership[]
  twoFactors TwoFactor[]
  @@map("users")
}
model Session {
  id String @id
  expiresAt DateTime
  token String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("sessions")
}
model Account {
  id String @id
  accountId String
  providerId String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
  @@unique([providerId, accountId])
  @@map("accounts")
}
model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
  @@map("verifications")
}
model TwoFactor {
  id String @id
  secret String
  verified Boolean @default(true)
  failedVerificationCount Int @default(0)
  lockedUntil DateTime?
  backupCodes String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("two_factors")
}
model Workspace {
  id String @id @default(cuid())
  name String
  segment String
  timeZone String @default("America/Sao_Paulo")
  locale String @default("pt-BR")
  plan String @default("free")
  isDemo Boolean @default(false)
  createdAt DateTime @default(now())
  members Membership[]
  bots Bot[]
  connections Connection[]
  contacts Contact[]
  conversations Conversation[]
  metrics DailyMetric[]
  auditLogs AuditLog[]
  flowVersions FlowVersion[]
  messages Message[]
  events WebhookEvent[]
  flowRuns FlowRun[]
  segments Segment[]
  whatsappTemplates WhatsAppTemplate[]
  campaigns Campaign[]
  recipients CampaignRecipient[]
  consentRecords ConsentRecord[]
  @@map("workspaces")
}
model Membership {
  id String @id @default(cuid())
  workspaceId String @map("workspace_id")
  userId String
  role String @default("owner")
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([workspaceId,userId])
  @@index([userId])
  @@map("memberships")
}
model Bot {
  id String @id @default(cuid())
  workspaceId String @map("workspace_id")
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name String
  description String
  status String @default("draft")
  channels String[] @default([])
  draft Json?
  draftRevision Int @default(0)
  settings Json @default("{}")
  versions FlowVersion[]
  connections Connection[]
  conversations Int @default(0)
  completionRate Float @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([workspaceId,id])
  @@map("bots")
}
model Connection {
  id String @id @default(cuid())
  workspaceId String @map("workspace_id")
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel String
  name String
  status String @default("pending")
  nextSendAt DateTime @default(now())
  credentialCiphertext String?
  mode String @default("real")
  externalAccountId String?
  verificationHash String? @unique
  settings Json @default("{}")
  botId String?
  bot Bot? @relation(fields: [workspaceId,botId], references: [workspaceId,id])
  contacts Contact[]
  conversations Conversation[]
  events WebhookEvent[]
  templates WhatsAppTemplate[]
  campaigns Campaign[]
  createdAt DateTime @default(now())
  @@unique([workspaceId,id])
  @@unique([channel,externalAccountId])
  @@index([workspaceId])
  @@map("connections")
}
model Contact {
  id String @id @default(cuid())
  workspaceId String @map("workspace_id")
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name String
  channel String
  email String?
  phone String?
  fields Json @default("{}")
  externalContactId String?
  connectionId String?
  connection Connection? @relation(fields: [workspaceId,connectionId], references: [workspaceId,id], onDelete: Cascade)
  tags String[] @default([])
  nextSendAt DateTime @default(now())
  consent Boolean @default(false)
  consentSource String?
  consentAt DateTime?
  marketingConsent Boolean @default(false)
  marketingSource String?
  marketingAt DateTime?
  createdAt DateTime @default(now())
  conversations Conversation[]
  recipients CampaignRecipient[]
  consentRecords ConsentRecord[]
  @@unique([workspaceId,id])
  @@unique([workspaceId,connectionId,externalContactId])
  @@map("contacts")
}
model Conversation {
  id String @id @default(cuid())
  workspaceId String @map("workspace_id")
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactId String
  contact Contact @relation(fields: [workspaceId,contactId], references: [workspaceId,id], onDelete: Cascade)
  connectionId String?
  connection Connection? @relation(fields: [workspaceId,connectionId], references: [workspaceId,id], onDelete: Cascade)
  versionId String?
  version FlowVersion? @relation(fields: [workspaceId,versionId], references: [workspaceId,id])
  session Json @default("{}")
  assignedUserId String?
  unread Int @default(0)
  lastInboundAt DateTime?
  updatedAt DateTime @default(now()) @updatedAt
  messages Message[]
  runs FlowRun[]
  mode String @default("bot")
  status String @default("open")
  channel String
  createdAt DateTime @default(now())
  @@unique([workspaceId,id])
  @@unique([workspaceId,connectionId,contactId])
  @@index([workspaceId,status])
  @@map("conversations")
}
model DailyMetric {
  id String @id @default(cuid())
  workspaceId String @map("workspace_id")
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  date DateTime @db.Date
  channel String
  sent Int @default(0)
  received Int @default(0)
  newContacts Int @default(0)
  completed Int @default(0)
  started Int @default(0)
  responseTimeMs Int @default(0)
  @@unique([workspaceId,date,channel])
  @@map("daily_metrics")
}
model AuditLog {
  id String @id @default(cuid())
  workspaceId String @map("workspace_id")
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId String
  action String
  createdAt DateTime @default(now())
  @@index([workspaceId,createdAt])
  @@map("audit_logs")
}

model FlowVersion {
  id String @id @default(cuid())
  workspaceId String @map("workspace_id")
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  botId String
  bot Bot @relation(fields: [workspaceId,botId], references: [workspaceId,id], onDelete: Cascade)
  number Int
  graph Json
  createdAt DateTime @default(now())
  conversations Conversation[]
  @@unique([workspaceId,id])
  @@unique([workspaceId,botId,number])
  @@map("flow_versions")
}
model Message {
  id String @id @default(cuid())
  workspaceId String @map("workspace_id")
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversationId String
  conversation Conversation @relation(fields: [workspaceId,conversationId], references: [workspaceId,id], onDelete: Cascade)
  direction String
  sender String @default("bot")
  campaignId String?
  campaign Campaign? @relation(fields:[workspaceId,campaignId],references:[workspaceId,id],onDelete:NoAction)
  recipients CampaignRecipient[]
  kind String @default("text")
  content Json
  status String @default("received")
  externalId String?
  idempotencyKey String?
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([workspaceId,idempotencyKey])
  @@unique([workspaceId,id])
  @@index([workspaceId,conversationId,createdAt])
  @@index([status,nextAttemptAt])
  @@map("messages")
}
model WebhookEvent {
  id String @id @default(cuid())
  workspaceId String @map("workspace_id")
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId String
  connection Connection @relation(fields: [workspaceId,connectionId], references: [workspaceId,id], onDelete: Cascade)
  externalId String
  payload Json
  status String @default("pending")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([workspaceId,connectionId,externalId])
  @@index([status,nextAttemptAt])
  @@map("webhook_events")
}
model FlowRun {
  id String @id @default(cuid())
  workspaceId String @map("workspace_id")
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversationId String
  conversation Conversation @relation(fields: [workspaceId,conversationId], references: [workspaceId,id], onDelete: Cascade)
  trace Json
  errors String[] @default([])
  createdAt DateTime @default(now())
  @@index([workspaceId,conversationId,createdAt])
  @@map("flow_runs")
}

model Segment {
  id String @id @default(cuid())
  workspaceId String @map("workspace_id")
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  name String
  filters Json
  createdAt DateTime @default(now())
  @@unique([workspaceId,id])
  @@unique([workspaceId,name])
  @@map("segments")
}
model ConsentRecord {
  id String @id @default(cuid())
  workspaceId String @map("workspace_id")
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  contactId String
  contact Contact @relation(fields:[workspaceId,contactId],references:[workspaceId,id],onDelete:Cascade)
  scope String
  granted Boolean
  source String
  createdAt DateTime @default(now())
  @@index([workspaceId,contactId,createdAt])
  @@map("consent_records")
}
model WhatsAppTemplate {
  id String @id @default(cuid())
  workspaceId String @map("workspace_id")
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  connectionId String
  connection Connection @relation(fields:[workspaceId,connectionId],references:[workspaceId,id],onDelete:Cascade)
  externalId String?
  name String
  language String @default("pt_BR")
  category String
  body String
  status String @default("PENDING")
  supported Boolean @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  campaigns Campaign[]
  @@unique([workspaceId,id])
  @@unique([workspaceId,connectionId,name,language])
  @@map("whatsapp_templates")
}
model Campaign {
  id String @id @default(cuid())
  workspaceId String @map("workspace_id")
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  connectionId String
  connection Connection @relation(fields:[workspaceId,connectionId],references:[workspaceId,id],onDelete:NoAction)
  name String
  status String @default("draft")
  content Json
  filters Json
  templateId String?
  template WhatsAppTemplate? @relation(fields:[workspaceId,templateId],references:[workspaceId,id],onDelete:NoAction)
  templateFingerprint String?
  estimatedCostCents Int @default(0)
  scheduledAt DateTime?
  startedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  recipients CampaignRecipient[]
  messages Message[]
  @@unique([workspaceId,id])
  @@index([status,scheduledAt])
  @@map("campaigns")
}
model CampaignRecipient {
  id String @id @default(cuid())
  workspaceId String @map("workspace_id")
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  campaignId String
  campaign Campaign @relation(fields:[workspaceId,campaignId],references:[workspaceId,id],onDelete:Cascade)
  contactId String
  contact Contact @relation(fields:[workspaceId,contactId],references:[workspaceId,id],onDelete:Cascade)
  messageId String?
  message Message? @relation(fields:[workspaceId,messageId],references:[workspaceId,id],onDelete:NoAction)
  status String @default("pending")
  reason String?
  segments Int @default(0)
  createdAt DateTime @default(now())
  @@unique([workspaceId,campaignId,contactId])
  @@index([workspaceId,campaignId,status])
  @@map("campaign_recipients")
}
